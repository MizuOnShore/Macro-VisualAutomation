<?xml version="1.0"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Macro.Windows" x:Class="Macro.Windows.MainWindow" Title="Macro &#x2014; Automation Studio" Width="1420" Height="880" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#07121D" Foreground="#F4F7FA" FontFamily="Segoe UI" FontSize="14">
  <Window.Icon>
    <DrawingImage>
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#E7334A" Geometry="M0,0 H32 V32 H0 Z"/>
          <GeometryDrawing Brush="Transparent" Geometry="M7,7 H18 V18 H7 Z">
            <GeometryDrawing.Pen><Pen Brush="White" Thickness="3"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="White" Geometry="M20,20 H27 V27 H20 Z"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
  </Window.Icon>
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#07121D"/>
    <SolidColorBrush x:Key="ToolbarBrush" Color="#091A29"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#081827"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#0A2032"/>
    <SolidColorBrush x:Key="CardBrush" Color="#0E273B"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="#153753"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#1E4563"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1785FF"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#8DA3B8"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F4F7FA"/>
      <Setter Property="Background" Value="#153753"/>
      <Setter Property="BorderBrush" Value="#285574"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1C4668"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Opacity" Value=".78"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value=".38"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#147EF5"/>
      <Setter Property="BorderBrush" Value="#2992FF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#5A2431"/>
      <Setter Property="BorderBrush" Value="#824052"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="8,2"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#102C43"/>
      <Setter Property="Foreground" Value="#F5F8FA"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="BorderBrush" Value="#285574"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#153753"/>
      <Setter Property="Foreground" Value="#F5F8FA"/>
      <Setter Property="BorderBrush" Value="#285574"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#F5F8FA"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="row" Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,9">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="row" Property="Background" Value="#112F48"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="row" Property="Background" Value="#123B62"/>
                <Setter TargetName="row" Property="BorderBrush" Value="#277FD1"/>
                <Setter TargetName="row" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#708AA1"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="214"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#17364E" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="82"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="132"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="16,16,10,12">
          <Border Width="42" Height="42" CornerRadius="13" Background="#E7334A">
            <Grid>
              <Ellipse Width="20" Height="20" Stroke="White" StrokeThickness="3"/>
              <Ellipse Width="6" Height="6" Fill="White"/>
            </Grid>
          </Border>
          <StackPanel Margin="11,2,0,0">
            <TextBlock Text="Macro" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Automation studio" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,12">
          <Button Style="{StaticResource NavButton}" Tag="Macros" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x2318;" FontSize="18" Width="32"/>
              <TextBlock Text="Macros" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource NavButton}" Tag="Recorder" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x25CF;" Foreground="#EF4053" FontSize="16" Width="32"/>
              <TextBlock Text="Recorder" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource NavButton}" Tag="Target" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x25CE;" Foreground="#43BDE0" FontSize="18" Width="32"/>
              <TextBlock Text="Target" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource NavButton}" Tag="Logs" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x2261;" FontSize="20" Width="32"/>
              <TextBlock Text="Logs" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource NavButton}" Tag="Automation" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x25C7;" Foreground="#A774FF" FontSize="18" Width="32"/>
              <TextBlock Text="Automation" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource NavButton}" Tag="Settings" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x2699;" FontSize="17" Width="32"/>
              <TextBlock Text="Settings" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="#17364E" BorderThickness="0,1,0,0" Padding="14">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="34" Height="34" CornerRadius="10" Background="#12324B">
                <TextBlock Text="&#x25CE;" Foreground="#6E8498" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="9,0,0,0">
                <TextBlock x:Name="SidebarTarget" Text="No target" FontWeight="SemiBold"/>
                <TextBlock x:Name="SidebarTargetSub" Text="Choose a window" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
              </StackPanel>
            </StackPanel>
            <Separator Margin="0,13,0,9" Background="#21425B"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="ActivityDot" Width="7" Height="7" Fill="#6E8498" Margin="0,0,8,0"/>
              <TextBlock x:Name="SidebarActivity" Grid.Column="1" Text="Ready" FontSize="12"/>
              <TextBlock Grid.Column="2" Text="BETA" Foreground="#6E8498" FontSize="10"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="64"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{StaticResource ToolbarBrush}" BorderBrush="#17364E" BorderThickness="0,0,0,1">
        <Grid Margin="18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="34" Height="34" CornerRadius="9" Background="#133B63">
              <TextBlock x:Name="HeaderIcon" Text="&#x2318;" Foreground="{StaticResource AccentBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="HeaderTitle" Text="Macros" FontSize="18" FontWeight="SemiBold" Margin="10,0,14,0" VerticalAlignment="Center"/>
            <Border Background="#102A3E" CornerRadius="14" Padding="10,5">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="HeaderDot" Width="7" Height="7" Fill="#6E8498" Margin="0,0,7,0"/>
                <TextBlock x:Name="HeaderStatus" Text="Ready" FontSize="12"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Click="PlayClicked" Padding="16,8" Margin="0,0,8,0">&#x25B6;  Play</Button>
            <Button x:Name="PauseButton" Click="PauseClicked" Width="40" Margin="0,0,8,0">&#x2161;</Button>
            <Button x:Name="StopButton" Click="StopClicked" Width="40">&#x25A0;</Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <!-- MACROS -->
        <Grid x:Name="MacrosPage">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
          </Grid.ColumnDefinitions>
          <Border Background="#081827" BorderBrush="#17364E" BorderThickness="0,0,1,0" Padding="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DockPanel Margin="2,0,2,12">
                <TextBlock Text="MACRO LIBRARY" Style="{StaticResource Section}"/>
                <Border DockPanel.Dock="Right" Background="#153753" CornerRadius="10" Padding="8,3">
                  <TextBlock x:Name="MacroCount" Text="0" FontSize="11"/>
                </Border>
              </DockPanel>
              <TextBox x:Name="MacroSearch" Grid.Row="1" TextChanged="MacroSearchChanged" Margin="0,0,0,12" ToolTip="Search macros"/>
              <ListBox x:Name="MacroList" Grid.Row="2" SelectionChanged="MacroSelected">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="30" Height="30" CornerRadius="8" Background="#153B5A">
                        <TextBlock Text="&#x2318;" Foreground="#4C9CFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Actions.Count, StringFormat={}{0} actions}" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Grid.Row="3">
                <Button Style="{StaticResource PrimaryButton}" Click="NewMacro" Margin="0,10,0,7">&#xFF0B;  New Macro</Button>
                <UniformGrid Columns="3">
                  <Button Click="DuplicateMacro" Margin="0,0,5,0">Duplicate</Button>
                  <Button Click="ImportMacro" Margin="0,0,5,0">Import</Button>
                  <Button Click="ExportMacro">Export</Button>
                </UniformGrid>
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Column="1" Margin="22">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="SEQUENCE" Style="{StaticResource Section}"/>
              <TextBox x:Name="MacroName" FontSize="26" FontWeight="Bold" Background="Transparent" BorderThickness="0" Padding="0,2" TextChanged="MacroNameChanged"/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Playback" FontWeight="SemiBold"/>
                  <TextBlock Text="Configure repeats and mouse behavior" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
                </StackPanel>
                <ComboBox x:Name="LoopModeBox" Grid.Column="1" Width="125" Margin="12,0,8,0" SelectionChanged="MacroOptionChanged"/>
                <TextBox x:Name="LoopCountBox" Grid.Column="2" Width="54" Margin="0,0,8,0" TextChanged="MacroOptionChanged"/>
                <ComboBox x:Name="PlaybackModeBox" Grid.Column="3" Width="138" SelectionChanged="MacroOptionChanged"/>
              </Grid>
            </Border>
            <ListBox x:Name="ActionList" Grid.Row="2" SelectionChanged="ActionSelected">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#0E273B" BorderBrush="#1E4563" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="10" Background="#153B5A">
                        <TextBlock Text="&#x25C6;" Foreground="#4C9CFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Type}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding}" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
                      </StackPanel>
                          <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" Click="ActionEnabledChanged" VerticalAlignment="Center" ToolTip="Enable or disable this action"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Grid.Row="3" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="AddActionBox" Width="150"/>
                <Button Style="{StaticResource PrimaryButton}" Click="AddAction" Margin="8,0,0,0">&#xFF0B; Add Action</Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Click="MoveActionUp" Width="38" Margin="0,0,6,0">&#x2191;</Button>
                <Button Click="MoveActionDown" Width="38" Margin="0,0,6,0">&#x2193;</Button>
                <Button Style="{StaticResource DangerButton}" Click="RemoveAction">Remove</Button>
              </StackPanel>
            </DockPanel>
          </Grid>
          <Border Grid.Column="2" Background="#081827" BorderBrush="#17364E" BorderThickness="1,0,0,0" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ActionInspector">
                <TextBlock Text="ACTION INSPECTOR" Style="{StaticResource Section}"/>
                <TextBlock x:Name="ActionInspectorTitle" Text="Select an action" FontSize="20" FontWeight="Bold" Margin="0,0,0,18"/>
                <TextBlock Text="TYPE" Style="{StaticResource Section}"/>
                <ComboBox x:Name="ActionTypeBox" SelectionChanged="ActionEditorChanged" Margin="0,0,0,14"/>
                <StackPanel x:Name="KeyFields">
                  <TextBlock Text="KEY" Style="{StaticResource Section}"/>
                  <TextBox x:Name="ActionKey" TextChanged="ActionEditorChanged" Margin="0,0,0,14"/>
                </StackPanel>
                <TextBlock Text="DELAY BEFORE ACTION (SECONDS)" Style="{StaticResource Section}"/>
                <TextBox x:Name="ActionDelay" TextChanged="ActionEditorChanged" Margin="0,0,0,14"/>
                <StackPanel x:Name="DurationFields">
                  <TextBlock Text="DURATION (SECONDS)" Style="{StaticResource Section}"/>
                  <TextBox x:Name="ActionDuration" TextChanged="ActionEditorChanged" Margin="0,0,0,14"/>
                </StackPanel>
                <StackPanel x:Name="PointFields">
                  <TextBlock Text="POSITION" Style="{StaticResource Section}"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/>
                      <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ActionX" TextChanged="ActionEditorChanged" Margin="0,0,5,10"/>
                    <TextBox x:Name="ActionY" Grid.Column="1" TextChanged="ActionEditorChanged" Margin="5,0,0,10"/>
                  </Grid>
                  <CheckBox x:Name="WindowCoordinates" Content="Window-relative coordinates" Checked="ActionEditorChanged" Unchecked="ActionEditorChanged" Margin="0,0,0,14"/>
                </StackPanel>
                <StackPanel x:Name="ScrollFields">
                  <TextBlock Text="SCROLL DELTA" Style="{StaticResource Section}"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/>
                      <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ScrollX" TextChanged="ActionEditorChanged" Margin="0,0,5,10"/>
                    <TextBox x:Name="ScrollY" Grid.Column="1" TextChanged="ActionEditorChanged" Margin="5,0,0,10"/>
                  </Grid>
                </StackPanel>
                <StackPanel x:Name="ActionAdvancedFields"/>
                <Button Style="{StaticResource DangerButton}" Click="DeleteMacro" Margin="0,24,0,0">Delete Macro</Button>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <!-- RECORDER -->
        <ScrollViewer x:Name="RecorderPage" Visibility="Collapsed">
          <StackPanel Width="860" Margin="34">
            <TextBlock Text="CAPTURE" Style="{StaticResource Section}"/>
            <TextBlock Text="Recorder" FontSize="34" FontWeight="Bold"/>
            <TextBlock Text="Keyboard, mouse clicks, pointer movement, and timing&#x2014;captured automatically." Foreground="{StaticResource SecondaryBrush}" FontSize="15" Margin="0,4,0,22"/>
            <Border Style="{StaticResource Card}" Padding="26">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="126" Height="126">
                  <Ellipse Fill="#281520" Stroke="#6E2B3A"/>
                  <Button x:Name="RecordButton" Click="RecordClicked" Width="76" Height="76" Background="#E7354D" BorderBrush="#F16376" FontSize="28">&#x25CF;</Button>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                  <TextBlock x:Name="RecordState" Text="READY TO RECORD" Foreground="#EF4053" FontSize="11" FontWeight="Bold"/>
                  <TextBlock x:Name="RecordTitle" Text="Create the next sequence" FontSize="26" FontWeight="Bold" Margin="0,7"/>
                  <TextBlock x:Name="RecordDescription" Text="Start here, switch to your target window, and perform the keyboard and mouse actions you want to replay." Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Button x:Name="RecordMainButton" Style="{StaticResource PrimaryButton}" Click="RecordClicked">&#x25CF;  Start Recording</Button>
                    <Border Background="#153753" CornerRadius="7" Padding="10,7" Margin="10,0,0,0">
                      <TextBlock Text="F6" FontWeight="SemiBold"/>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <UniformGrid Columns="2" Margin="0,14">
              <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                <StackPanel>
                  <TextBlock Text="&#x303D;  New macro for every recording" FontWeight="SemiBold"/>
                  <TextBlock Text="Saved and selected automatically when you press Stop" Foreground="{StaticResource SecondaryBrush}" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                <StackPanel>
                  <TextBlock x:Name="RecorderTarget" Text="&#x25CE;  No target selected" FontWeight="SemiBold"/>
                  <TextBlock Text="Select a target for window-relative mouse positions" Foreground="{StaticResource SecondaryBrush}" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <TextBlock Text="GLOBAL CONTROLS" Style="{StaticResource Section}" Margin="0,16,0,8"/>
            <UniformGrid Columns="3">
              <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                <TextBlock Text="&#x25CF;  Record                                      F6"/>
              </Border>
              <Border Style="{StaticResource Card}" Margin="7,0">
                <TextBlock Text="&#x25A0;  Stop                                         F7"/>
              </Border>
              <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                <TextBlock Text="&#x25B6;  Play                                          F8"/>
              </Border>
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>
        <!-- TARGET -->
        <Grid x:Name="TargetPage" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Background="#081827" BorderBrush="#17364E" BorderThickness="0,0,1,0" Padding="16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,12">
                <TextBlock Text="AVAILABLE WINDOWS" Style="{StaticResource Section}"/>
                <Button DockPanel.Dock="Right" Click="RefreshTargets" Padding="10,5">&#x21BB; Refresh</Button>
              </DockPanel>
              <ListBox x:Name="TargetList" Grid.Row="1" SelectionChanged="TargetSelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding WindowTitle}" Foreground="{StaticResource SecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Width, StringFormat={}{0}px wide}" Foreground="#617A91" FontSize="10"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Click="SelectTarget" Margin="0,12,0,0">Select Highlighted Window</Button>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="28" Width="600" HorizontalAlignment="Left">
            <TextBlock Text="TARGET WINDOW" Style="{StaticResource Section}"/>
            <TextBlock x:Name="TargetTitle" Text="No target selected" FontSize="30" FontWeight="Bold"/>
            <TextBlock x:Name="TargetSubtitle" Text="Choose a visible application window to receive the macro." Foreground="{StaticResource SecondaryBrush}" Margin="0,5,0,20"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Diagnostics" FontWeight="SemiBold" FontSize="17"/>
                <TextBlock Text="Post a harmless test event before running a sequence. Posted does not guarantee the application consumed it." Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                <StackPanel Orientation="Horizontal">
                  <Button Click="TestKey">Test E key</Button>
                  <Button Click="TestClick" Margin="8,0,0,0">Test center click</Button>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock x:Name="DiagnosticText" Foreground="#6F94B2" TextWrapping="Wrap" Margin="0,14"/>
          </StackPanel>
        </Grid>
        <!-- AUTOMATION -->
        <Grid x:Name="AutomationPage" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
          </Grid.ColumnDefinitions>
          <Border Background="#081827" BorderBrush="#17364E" BorderThickness="0,0,1,0" Padding="13">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="WORKFLOWS" Style="{StaticResource Section}"/>
              <ListBox x:Name="AutomationList" Grid.Row="1" SelectionChanged="AutomationSelected">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Nodes.Count, StringFormat={}{0} nodes}" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="2" Text="NODE LIBRARY" Style="{StaticResource Section}" Margin="0,12,0,8"/>
              <ScrollViewer Grid.Row="3">
                <WrapPanel x:Name="NodeLibrary"/>
              </ScrollViewer>
              <Button Grid.Row="4" Style="{StaticResource PrimaryButton}" Click="NewAutomation" Margin="0,10,0,0">&#xFF0B; New Workflow</Button>
            </Grid>
          </Border>
          <Grid Grid.Column="1">
            <local:WorkflowCanvas x:Name="FlowCanvas"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC0A2032" BorderBrush="#285574" BorderThickness="1" CornerRadius="10" Padding="8" Margin="12">
              <StackPanel Orientation="Horizontal">
                <Button Click="FitWorkflow" Padding="10,6">Fit</Button>
                <Button Click="RunAutomation" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" Padding="12,6">&#x25B6; Run</Button>
              </StackPanel>
            </Border>
          </Grid>
          <Border Grid.Column="2" Background="#081827" BorderBrush="#17364E" BorderThickness="1,0,0,0" Padding="17">
            <ScrollViewer>
              <StackPanel>
                <TextBlock Text="INSPECTOR" Style="{StaticResource Section}"/>
                <TextBox x:Name="AutomationName" FontSize="20" FontWeight="Bold" Background="Transparent" BorderThickness="0" Padding="0" TextChanged="AutomationNameChanged" Margin="0,0,0,14"/>
                <TextBlock x:Name="NodeInspectorTitle" Text="Select a node" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="NodeKindText" Foreground="{StaticResource SecondaryBrush}" Margin="0,4,0,14"/>
                <StackPanel x:Name="MacroNodeFields">
                  <TextBlock Text="MACRO" Style="{StaticResource Section}"/>
                  <ComboBox x:Name="NodeMacroBox" SelectionChanged="NodeEditorChanged" Margin="0,0,0,14"/>
                </StackPanel>
                <StackPanel x:Name="WaitNodeFields">
                  <TextBlock Text="WAIT DURATION (SECONDS)" Style="{StaticResource Section}"/>
                  <TextBox x:Name="NodeWait" TextChanged="NodeEditorChanged" Margin="0,0,0,14"/>
                </StackPanel>
                <StackPanel x:Name="RepeatNodeFields">
                  <TextBlock Text="REPEAT COUNT" Style="{StaticResource Section}"/>
                  <TextBox x:Name="NodeRepeat" TextChanged="NodeEditorChanged" Margin="0,0,0,14"/>
                </StackPanel>
                <StackPanel x:Name="DynamicNodeFields"/>
                <TextBlock Text="CONNECT TO" Style="{StaticResource Section}"/>
                <ComboBox x:Name="NodeConnectTarget" Margin="0,0,0,8"/>
                <ComboBox x:Name="NodeBranch" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button Click="ConnectNode" Margin="0,0,4,0">Connect Output</Button>
                  <Button Grid.Column="1" Click="DisconnectNode" Margin="4,0,0,0">Disconnect</Button>
                </Grid>
                <TextBlock Text="VALIDATION" Style="{StaticResource Section}" Margin="0,22,0,8"/>
                <Border Style="{StaticResource Card}" Padding="12">
                  <TextBlock x:Name="ValidationText" Text="Select a workflow" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/>
                </Border>
                <Button Style="{StaticResource DangerButton}" Click="DeleteNode" Margin="0,22,0,0">Delete Selected Node</Button>
                <Button Style="{StaticResource DangerButton}" Click="DeleteAutomation" Margin="0,8,0,0">Delete Workflow</Button>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <!-- LOGS -->
        <Grid x:Name="LogsPage" Visibility="Collapsed" Margin="24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="ACTIVITY" Style="{StaticResource Section}"/>
              <TextBlock Text="Logs" FontSize="30" FontWeight="Bold"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Click="ClearLogs">Clear</Button>
          </DockPanel>
          <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="16"/>
        </Grid>
        <!-- SETTINGS -->
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
          <StackPanel Width="760" Margin="34">
            <TextBlock Text="PREFERENCES" Style="{StaticResource Section}"/>
            <TextBlock Text="Settings" FontSize="34" FontWeight="Bold"/>
            <TextBlock Text="Global controls and Windows input behavior" Foreground="{StaticResource SecondaryBrush}" Margin="0,5,0,22"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Global hotkeys" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="These shortcuts work while Macro is in the background." Foreground="{StaticResource SecondaryBrush}" Margin="0,4,0,14"/>
                <UniformGrid Columns="3">
                  <Border Background="#153753" CornerRadius="10" Padding="13" Margin="0,0,6,0">
                    <TextBlock Text="&#x25CF; Record     F6"/>
                  </Border>
                  <Border Background="#153753" CornerRadius="10" Padding="13" Margin="6,0">
                    <TextBlock Text="&#x25A0; Stop        F7"/>
                  </Border>
                  <Border Background="#153753" CornerRadius="10" Padding="13" Margin="6,0,0,0">
                    <TextBlock Text="&#x25B6; Play        F8"/>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Playback modes" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Background sends messages to the selected window without moving focus. Compatibility activates the target and uses Windows SendInput for applications that ignore background messages." Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Data folder" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="DataFolderText" Foreground="{StaticResource SecondaryBrush}" Margin="0,7,0,12"/>
                <Button Click="OpenDataFolder" HorizontalAlignment="Left">Open Data Folder</Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
