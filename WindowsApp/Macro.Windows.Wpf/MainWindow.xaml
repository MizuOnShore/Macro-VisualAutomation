                      <MenuItem Header="Duplicate" Click="DuplicateMacro"/>
                      <MenuItem Header="Import JSON…" Click="ImportMacro"/>
                      <MenuItem Header="Export JSON…" Click="ExportMacro"/>
                      <Separator/>
                      <MenuItem Header="Delete" Click="DeleteMacro"/>
                    </ContextMenu></Button.ContextMenu>
                  </Button>
                </Grid>
                <Grid x:Name="ActionFooter" Visibility="Collapsed" Margin="14,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="AddActionBox" MinWidth="105" Margin="0,0,7,0"/><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="AddAction" Padding="11,8" Margin="0,0,7,0">＋ Add</Button><Button Grid.Column="2" Click="MoveActionUp" Width="38" Margin="0,0,6,0">↑</Button><Button Grid.Column="3" Click="MoveActionDown" Width="38" Margin="0,0,6,0">↓</Button><Button Grid.Column="4" Click="RemoveAction" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" Padding="9,6">Remove</Button><Button Grid.Column="5" Click="ReturnToMacroOverview" Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderBrush="Transparent" Padding="8,6">Overview</Button></Grid>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="16">
            <Grid>
              <ScrollViewer x:Name="MacroOverviewCard" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MacroInspectorOverview">
                  <TextBlock Text="RECORDING DETAILS" Style="{StaticResource Section}"/>
                  <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                      <TextBox x:Name="MacroName" FontSize="17" FontWeight="Bold" Background="Transparent" BorderThickness="0" Padding="0" TextChanged="MacroNameChanged"/>
                      <local:RecordingWaveform x:Name="InspectorWaveform" Height="46" Tint="{DynamicResource AccentBrush}" Margin="0,10,0,8"/>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="InspectorActionSummary" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/><TextBlock x:Name="InspectorLoopSummary" Grid.Column="1" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/></Grid>
                      <Button x:Name="PlayRecordingButton" Style="{StaticResource PrimaryButton}" Click="PlayClicked" Margin="0,13,0,0">▶  Play Recording</Button>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="PLAYBACK" Style="{StaticResource Section}" Margin="0,20,0,8"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="Repeat" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center"/><ComboBox x:Name="LoopModeBox" Grid.Column="1" SelectionChanged="MacroOptionChanged"/></Grid>
                  <Grid x:Name="LoopCountRow" Visibility="Collapsed" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions><TextBlock Text="Times" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center"/><TextBox x:Name="LoopCountBox" Grid.Column="1" TextChanged="MacroOptionChanged"/></Grid>
                  <Grid x:Name="MacroPlaybackRow" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MacroPlaybackLabel" Text="Mouse playback" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center"/>
                    <Border x:Name="MacroPlaybackSegments" Grid.Column="1" Background="{DynamicResource RaisedBrush}" CornerRadius="7" Padding="3">
                      <UniformGrid Columns="2"><RadioButton x:Name="BackgroundModeButton" Content="Background" Style="{StaticResource PlaybackSegment}" GroupName="MacroPlaybackMode" Checked="PlaybackModeChanged"/><RadioButton x:Name="CompatibilityModeButton" Content="Compatibility" Style="{StaticResource PlaybackSegment}" GroupName="MacroPlaybackMode" Checked="PlaybackModeChanged"/></UniformGrid>
                    </Border>
                  </Grid>
                  <TextBlock Text="RECORDED CONTENT" Style="{StaticResource Section}" Margin="0,20,0,6"/>
                  <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="⌨" Foreground="#398BFF"/><TextBlock Grid.Column="1" Text="Keyboard" Foreground="{StaticResource SecondaryBrush}"/><TextBlock x:Name="InspectorKeyboardCount" Grid.Column="2" FontWeight="SemiBold"/></Grid>
                  <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="♙" Foreground="#B351E2"/><TextBlock Grid.Column="1" Text="Mouse" Foreground="{StaticResource SecondaryBrush}"/><TextBlock x:Name="InspectorMouseCount" Grid.Column="2" FontWeight="SemiBold"/></Grid>
                  <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="◎" Foreground="#E69527"/><TextBlock Grid.Column="1" Text="Target" Foreground="{StaticResource SecondaryBrush}"/><TextBlock x:Name="InspectorTargetName" Grid.Column="2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="145"/></Grid>
                  <Button Click="EditActions" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource CardBrush}" BorderBrush="Transparent" Margin="0,17,0,0">☷  Edit Actions</Button>
                  <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="OverviewTitle"/><TextBlock x:Name="OverviewTarget"/><TextBlock x:Name="OverviewCount"/>
                    <TextBlock x:Name="OverviewMode"/><TextBlock x:Name="OverviewInput"/><TextBlock x:Name="InspectorTarget"/>
                    <TextBlock x:Name="InspectorPlayback"/><TextBlock x:Name="InspectorActions"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
              <ScrollViewer x:Name="ActionInspectorScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ActionInspector">
                  <TextBlock Text="ACTION INSPECTOR" Style="{StaticResource Section}"/>
                  <TextBlock x:Name="ActionInspectorTitle" Text="Select an action" FontSize="20" FontWeight="Bold" Margin="0,0,0,18"/>
                  <TextBlock Text="TYPE" Style="{StaticResource Section}"/>
                  <ComboBox x:Name="ActionTypeBox" SelectionChanged="ActionEditorChanged" Margin="0,0,0,14"/>
                  <StackPanel x:Name="KeyFields"><TextBlock Text="KEY" Style="{StaticResource Section}"/><TextBox x:Name="ActionKey" TextChanged="ActionEditorChanged" Margin="0,0,0,14"/></StackPanel>
                  <TextBlock Text="DELAY BEFORE ACTION (SECONDS)" Style="{StaticResource Section}"/><TextBox x:Name="ActionDelay" TextChanged="ActionEditorChanged" Margin="0,0,0,14"/>
                  <StackPanel x:Name="DurationFields"><TextBlock Text="DURATION (SECONDS)" Style="{StaticResource Section}"/><TextBox x:Name="ActionDuration" TextChanged="ActionEditorChanged" Margin="0,0,0,14"/></StackPanel>
                  <StackPanel x:Name="PointFields"><TextBlock Text="POSITION" Style="{StaticResource Section}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="ActionX" TextChanged="ActionEditorChanged" Margin="0,0,5,10"/><TextBox x:Name="ActionY" Grid.Column="1" TextChanged="ActionEditorChanged" Margin="5,0,0,10"/></Grid><CheckBox x:Name="WindowCoordinates" Content="Window-relative coordinates" Checked="ActionEditorChanged" Unchecked="ActionEditorChanged" Margin="0,0,0,14"/></StackPanel>
                  <StackPanel x:Name="ScrollFields"><TextBlock Text="SCROLL DELTA" Style="{StaticResource Section}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="ScrollX" TextChanged="ActionEditorChanged" Margin="0,0,5,10"/><TextBox x:Name="ScrollY" Grid.Column="1" TextChanged="ActionEditorChanged" Margin="5,0,0,10"/></Grid></StackPanel>
                  <StackPanel x:Name="ActionAdvancedFields"/><Button Style="{StaticResource DangerButton}" Click="DeleteMacro" Margin="0,24,0,0">Delete Macro</Button>
                </StackPanel>
              </ScrollViewer>
              <StackPanel x:Name="MacroNoSelection" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="▣" FontSize="28" Foreground="#71859A" HorizontalAlignment="Center"/>
                <TextBlock Text="No Macro Selected" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                <TextBlock Text="Create a macro to begin adding actions." Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <!-- RECORDER -->
        <ScrollViewer x:Name="RecorderPage" Visibility="Collapsed" Background="{DynamicResource WindowBrush}">
          <StackPanel MaxWidth="850" Margin="28" HorizontalAlignment="Center">
            <TextBlock Text="CAPTURE" Style="{StaticResource Section}"/>
            <TextBlock Text="Recorder" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Keyboard, mouse clicks, pointer movement, and timing&#x2014;captured automatically." Foreground="{StaticResource SecondaryBrush}" FontSize="13" Margin="0,4,0,18"/>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="126"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="126" Height="126">
                  <Ellipse Fill="#281620"/>
                  <Ellipse Width="105" Height="105" Fill="Transparent" Stroke="#6E2B3A" StrokeThickness="1"/>
                  <Button x:Name="RecordButton" Click="RecordClicked" Width="76" Height="76" Background="#25151E" BorderBrush="#8D2537" Foreground="#F13B51" FontSize="29">◎
                    <Button.Template><ControlTemplate TargetType="Button"><Grid><Ellipse x:Name="RecordSurface" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RecordSurface" Property="Fill" Value="#381A28"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="RecordSurface" Property="Opacity" Value=".75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                  </Button>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0">
                  <TextBlock x:Name="RecordState" Text="●  READY TO RECORD" Foreground="#8DA3B8" FontSize="11" FontWeight="Bold"/>
                  <TextBlock x:Name="RecordTitle" Text="Create the next sequence" FontSize="22" FontWeight="Bold" Margin="0,7"/>
                  <TextBlock x:Name="RecordDescription" Text="Start here, switch to your target window, and perform the keyboard and mouse actions you want to replay." Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Button x:Name="RecordMainButton" Style="{StaticResource PrimaryButton}" Click="RecordClicked" Width="170" Height="32" Padding="6,4">&#x25CF;  Start Recording</Button>
                    <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="10,0,0,0">
                      <TextBlock x:Name="RecordHotkey" Text="F6" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                  </StackPanel>
                  <Button x:Name="ViewSavedMacroButton" Tag="Macros" Click="Navigate" Visibility="Collapsed" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderBrush="Transparent" Margin="0,7,0,0" Padding="0,5">▣  View saved macro</Button>
                </StackPanel>
              </Grid>
            </Border>
            <UniformGrid Columns="2" Margin="0,14">
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="14" Margin="0,0,7,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource CardBrush}" HorizontalAlignment="Left"><TextBlock Text="≋" Foreground="{DynamicResource AccentBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="New macro for every recording" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Saved and selected automatically when you press Stop" Foreground="{StaticResource SecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                </Grid>
              </Border>
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="14" Margin="7,0,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="38" Height="38" CornerRadius="10" Background="#2A2118" HorizontalAlignment="Left"><TextBlock x:Name="RecorderTargetIcon" Text="◎" Foreground="#E69527" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="RecorderTarget" Text="No target selected" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RecorderTargetSub" Text="Mouse positions use screen coordinates" Foreground="{StaticResource SecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                </Grid>
              </Border>
            </UniformGrid>
            <TextBlock Text="GLOBAL CONTROLS" Style="{StaticResource Section}" Margin="0,16,0,8"/>
            <UniformGrid Columns="3">
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,7,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="7" Background="#2A1720"><TextBlock Text="◎" Foreground="#EF3348" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="Record" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Grid.Column="2" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,3"><TextBlock Text="F6" FontSize="10"/></Border></Grid>
              </Border>
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="7,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="7" Background="#2C2219"><TextBlock Text="■" Foreground="#ED952A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="Stop" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Grid.Column="2" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,3"><TextBlock Text="F7" FontSize="10"/></Border></Grid>
              </Border>
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="7,0,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="7" Background="#122D26"><TextBlock Text="▶" Foreground="#28C775" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="Play" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Grid.Column="2" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,3"><TextBlock Text="F8" FontSize="10"/></Border></Grid>
              </Border>
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>
        <!-- TARGET -->
        <Grid x:Name="TargetPage" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="TargetLibraryColumn" Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel LastChildFill="False" Margin="12,12,12,10">
                <TextBlock Text="Available Windows" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Border Background="{DynamicResource RaisedBrush}" CornerRadius="12" Padding="8,4" Margin="0,0,7,0"><TextBlock x:Name="TargetCount" Text="0" FontSize="11"/></Border>
                  <Button Click="RefreshTargets" Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderBrush="Transparent" Padding="6,3" ToolTip="Refresh windows">↻</Button>
                </StackPanel>
              </DockPanel>
              <Grid Grid.Row="1" Margin="12,0,12,10">
                <TextBox x:Name="TargetSearch" Style="{StaticResource SearchField}" TextChanged="TargetSearchChanged" ToolTip="Search apps or windows"/>
                <TextBlock Text="Search apps or windows" Foreground="#788A9D" FontSize="12" VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TargetSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
              <Grid Grid.Row="2">
                <ListBox x:Name="TargetList" SelectionChanged="TargetSelectionChanged" Margin="5,0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="41"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="31" Height="31" CornerRadius="7" Background="#172431" HorizontalAlignment="Left" VerticalAlignment="Top"><Grid><TextBlock Text="▣" Foreground="#A4B0BC" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ProcessId, Converter={StaticResource ProcessIconConverter}}" Width="28" Height="28" Stretch="Uniform"/></Grid></Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding WindowTitle}" Foreground="{StaticResource SecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                          <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="PID " Foreground="#647789" FontSize="10"/><TextBlock Text="{Binding ProcessId}" Foreground="#647789" FontSize="10"/><TextBlock Text=" · " Foreground="#647789" FontSize="10"/><TextBlock Text="{Binding Width}" Foreground="#647789" FontSize="10"/><TextBlock Text=" × " Foreground="#647789" FontSize="10"/><TextBlock Text="{Binding Height}" Foreground="#647789" FontSize="10"/></StackPanel>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="TargetEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock Text="⌕" Foreground="#657B8F" FontSize="25" HorizontalAlignment="Center"/>
                  <TextBlock Text="No Matching Windows" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                  <TextBlock Text="Try another app name or process ID." Foreground="{StaticResource SecondaryBrush}" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
              <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="11,9">
                <TextBlock x:Name="TargetDiscoveryMessage" Text="Searching for windows…" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
              </Border>
            </Grid>
          </Border>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource PanelBrush}">
            <StackPanel MaxWidth="700" Margin="28,20" HorizontalAlignment="Center">
              <TextBlock Text="Selected Target" FontWeight="SemiBold" Margin="0,0,0,9"/>
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel>
                  <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Application"/><TextBlock x:Name="TargetApplicationValue" Grid.Column="1" Text="Not selected" Foreground="{StaticResource SecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="290"/></Grid>
                  <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Window"/><TextBlock x:Name="TargetWindowValue" Grid.Column="1" Text="—" Foreground="{StaticResource SecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="290"/></Grid>
                  <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Process ID"/><TextBlock x:Name="TargetProcessIdValue" Grid.Column="1" Text="—" Foreground="{StaticResource SecondaryBrush}"/></Grid>
                  <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Process"/><TextBlock x:Name="TargetProcessValue" Grid.Column="1" Text="Unavailable" Foreground="{StaticResource SecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="290"/></Grid>
                  <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Window size"/><TextBlock x:Name="TargetSizeValue" Grid.Column="1" Text="—" Foreground="{StaticResource SecondaryBrush}"/></Grid>
                  <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Status"/><Border Grid.Column="1" Background="#162333" CornerRadius="12" Padding="8,4"><TextBlock x:Name="TargetStatusValue" Text="No target" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/></Border></Grid>
                </StackPanel>
              </Border>
              <TextBlock Text="Selection" FontWeight="SemiBold" Margin="0,24,0,9"/>
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel>
                  <Button x:Name="SelectTargetButton" Click="SelectTarget" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" IsEnabled="False" Padding="12,6">Select Highlighted Window</Button>
                  <Separator Background="#1F3348" Margin="0,12"/>
                  <Button x:Name="ClearTargetButton" Click="ClearTarget" Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Left" IsEnabled="False" Padding="6,4">Clear Target</Button>
                </StackPanel>
              </Border>
              <TextBlock Text="Input Test" FontWeight="SemiBold" Margin="0,24,0,9"/>
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="Test action" VerticalAlignment="Center"/><ComboBox x:Name="TargetTestActionBox" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="Press E"/><ComboBoxItem Content="Click center"/></ComboBox></Grid>
                  <Separator Background="#1F3348" Margin="0,12"/>
                  <Button x:Name="TargetTestButton" Click="SendTargetTest" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource CardBrush}" BorderBrush="Transparent" IsEnabled="False" HorizontalAlignment="Left" Padding="9,6">Send Test Input</Button>
                  <TextBlock x:Name="DiagnosticText" Text="Select a target, then send a test input." Foreground="{StaticResource SecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0"/>
                </StackPanel>
              </Border>
              <StackPanel x:Name="TargetCompatibilitySection" Visibility="Collapsed">
                <TextBlock Text="Roblox Compatibility" FontWeight="SemiBold" Margin="0,24,0,9"/>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                  <StackPanel><TextBlock Text="⚠  Background receipt is unverified and may require focus" Foreground="#F29930" TextWrapping="Wrap"/><TextBlock Text="Games may read focused HID input rather than posted window messages. A successful send does not prove Roblox consumed the input." Foreground="{StaticResource SecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                </Border>
              </StackPanel>
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0"><TextBlock Text="Window discovery and process-targeted tests do not activate the selected application or move the physical cursor. Some window titles may be unavailable." Foreground="{StaticResource SecondaryBrush}" FontSize="11" TextWrapping="Wrap"/></Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <!-- AUTOMATION -->
        <Grid x:Name="AutomationPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="AutomationLibraryColumn" Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="AutomationInspectorColumn" Width="285"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#091A29" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="AutomationLibraryToggle" Click="ToggleAutomationLibrary" Padding="8,6" ToolTip="Show or hide the workflow library">◧</Button>
              <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="#0C2A45" Margin="8,0"><TextBlock Text="◇" Foreground="#4C9CFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock x:Name="AutomationToolbarTitle" Text="Automation" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="AutomationToolbarMeta" Text="0 nodes · 0 connections" Foreground="{StaticResource SecondaryBrush}" FontSize="10"/></StackPanel>
              <Button Grid.Column="3" Click="SaveAutomation" Padding="10,6" Margin="0,0,7,0">⇩  Save</Button>
              <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Click="RunAutomation" Padding="13,6" Margin="0,0,7,0">▶  Run</Button>
              <Button Grid.Column="5" Click="FitWorkflow" Padding="10,6">Fit</Button>
              <Button x:Name="AutomationInspectorToggle" Grid.Column="6" Click="ToggleAutomationInspector" Padding="8,6" Margin="7,0,0,0" ToolTip="Show or hide the automation inspector">◨</Button>
            </Grid>
          </Border>
          <Border x:Name="AutomationLibraryPanel" Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="13">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Margin="0,0,0,10"><TextBlock Text="WORKFLOWS" Style="{StaticResource Section}"/><TextBox x:Name="AutomationSearch" Style="{StaticResource SearchField}" TextChanged="AutomationSearchChanged" ToolTip="Search automations and nodes"/></StackPanel>
              <ListBox x:Name="AutomationList" Grid.Row="1" MaxHeight="170" SelectionChanged="AutomationSelected">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Nodes.Count, StringFormat={}{0} nodes}" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="2" Text="NODE LIBRARY" Style="{StaticResource Section}" Margin="0,12,0,8"/>
              <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="NodeLibrary"/>
              </ScrollViewer>
              <Button Grid.Row="4" Style="{StaticResource PrimaryButton}" Click="NewAutomation" Margin="0,10,0,0">&#xFF0B; New Workflow</Button>
            </Grid>
          </Border>
          <Grid Grid.Row="1" Grid.Column="1">
            <local:WorkflowCanvas x:Name="FlowCanvas" AllowDrop="True" DragOver="FlowCanvasDragOver" Drop="FlowCanvasDrop"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E60A2032" BorderBrush="#285574" BorderThickness="1" CornerRadius="12" Padding="9" Margin="14">
              <StackPanel Orientation="Horizontal"><TextBox x:Name="CanvasSearch" Style="{StaticResource SearchField}" Width="170" Height="34" TextChanged="CanvasSearchChanged" ToolTip="Find node"/><Button Click="CanvasZoomOut" MinWidth="36" MinHeight="34" Padding="9,6" Margin="7,0,0,0">−</Button><TextBlock x:Name="CanvasZoomText" Text="100%" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" Margin="9,0"/><Button Click="CanvasZoomIn" MinWidth="36" MinHeight="34" Padding="9,6">+</Button><Button Click="FitWorkflow" MinWidth="36" MinHeight="34" Padding="9,6" Margin="7,0,0,0">⌖</Button></StackPanel>
            </Border>
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="#E60A2032" BorderBrush="#285574" BorderThickness="1" CornerRadius="13" Padding="8" Margin="16"><StackPanel Orientation="Horizontal"><Button x:Name="CanvasSelectButton" MinWidth="44" MinHeight="40" Padding="11,8" FontSize="15" ToolTip="Select nodes · drag empty canvas for marquee selection" Click="CanvasSelectTool">↖</Button><Button x:Name="CanvasPanButton" MinWidth="44" MinHeight="40" Padding="11,8" FontSize="15" Margin="4,0,0,0" ToolTip="Pan canvas" Click="CanvasPanTool">☝</Button><Button MinWidth="44" MinHeight="40" Padding="11,8" FontSize="15" Margin="4,0,0,0" ToolTip="Fit workflow" Click="FitWorkflow">⌗</Button><Button MinWidth="44" MinHeight="40" Padding="11,8" FontSize="15" Margin="4,0,0,0" ToolTip="Reset zoom" Click="CanvasResetZoom">↗</Button></StackPanel></Border>
          </Grid>
          <Border x:Name="AutomationInspectorPanel" Grid.Row="1" Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="14">
            <ScrollViewer>
              <StackPanel>
                <TextBlock Text="AUTOMATION SETTINGS" Style="{StaticResource Section}"/>
                <TextBlock Text="Automation Name" Foreground="{StaticResource SecondaryBrush}" FontSize="11" Margin="0,6,0,5"/>
                <TextBox x:Name="AutomationName" FontSize="13" FontWeight="SemiBold" TextChanged="AutomationNameChanged" Margin="0,0,0,12"/>
                <TextBlock Text="Description" Foreground="{StaticResource SecondaryBrush}" FontSize="11" Margin="0,0,0,5"/>
                <TextBox x:Name="AutomationDescription" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" TextChanged="AutomationDescriptionChanged" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="Start mode" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center"/><ComboBox x:Name="StartModeBox" Grid.Column="1" SelectionChanged="AutomationStartModeChanged"/></Grid>
                <TextBlock Text="Status" Foreground="{StaticResource SecondaryBrush}" FontSize="11" Margin="0,0,0,5"/>
                <Border Background="#16212D" CornerRadius="8" HorizontalAlignment="Left" Padding="9,5" Margin="0,0,0,8"><TextBlock Text="●  Automation Ready" FontSize="11"/></Border>
                <TextBlock x:Name="AutomationSummary" Text="0 nodes · 0 connections" Foreground="{StaticResource SecondaryBrush}" FontSize="11" Margin="0,0,0,16"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,4"/>
                <StackPanel x:Name="NodeEditorPanel">
                <TextBlock x:Name="NodeInspectorTitle" Text="Select a node" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="NodeKindText" Foreground="{StaticResource SecondaryBrush}" Margin="0,4,0,14"/>
                <StackPanel x:Name="MacroNodeFields">
                  <TextBlock Text="MACRO" Style="{StaticResource Section}"/>
                  <ComboBox x:Name="NodeMacroBox" SelectionChanged="NodeEditorChanged" Margin="0,0,0,14"/>
                </StackPanel>
                <StackPanel x:Name="WaitNodeFields">
                  <TextBlock Text="WAIT DURATION (SECONDS)" Style="{StaticResource Section}"/>
                  <TextBox x:Name="NodeWait" TextChanged="NodeEditorChanged" Margin="0,0,0,14"/>
                </StackPanel>
                <StackPanel x:Name="RepeatNodeFields">
                  <TextBlock Text="REPEAT COUNT" Style="{StaticResource Section}"/>
                  <TextBox x:Name="NodeRepeat" TextChanged="NodeEditorChanged" Margin="0,0,0,14"/>
                </StackPanel>
                <StackPanel x:Name="DynamicNodeFields"/>
                <TextBlock Text="CONNECT TO" Style="{StaticResource Section}"/>
                <ComboBox x:Name="NodeConnectTarget" Margin="0,0,0,8"/>
                <ComboBox x:Name="NodeBranch" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button x:Name="ConnectButton" Click="ConnectNode" Margin="0,0,4,0" Padding="8">Connect</Button>
                  <Button x:Name="DisconnectButton" Grid.Column="1" Click="DisconnectNode" Margin="4,0,0,0" Padding="8">Disconnect</Button>
                </Grid>
                </StackPanel>
                <TextBlock Text="VALIDATION" Style="{StaticResource Section}" Margin="0,22,0,8"/>
                <Border Style="{StaticResource Card}" Padding="12">
                  <TextBlock x:Name="ValidationText" Text="Select a workflow" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/>
                </Border>
                <Button x:Name="DeleteNodeButton" Style="{StaticResource DangerButton}" Click="DeleteNode" Margin="0,22,0,0">Delete Selected Node</Button>
                <Button Style="{StaticResource DangerButton}" Click="DeleteAutomation" Margin="0,8,0,0">Delete Workflow</Button>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <!-- LOGS -->
        <Grid x:Name="LogsPage" Visibility="Collapsed" Background="{DynamicResource WindowBrush}">
          <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="TIME" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/>
              <TextBlock Grid.Column="1" Text="LEVEL" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/>
              <TextBlock Grid.Column="2" Text="MESSAGE" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/>
              <TextBox x:Name="LogSearch" Grid.Column="3" Style="{StaticResource SearchField}" Width="170" Margin="0,0,8,0" VerticalAlignment="Center" TextChanged="LogSearchChanged" ToolTip="Search logs"/>
              <Button Grid.Column="4" Click="ClearLogs" Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderBrush="Transparent" Padding="8,5" VerticalAlignment="Center">Clear</Button>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource SecondaryBrush}" FontFamily="Consolas" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{Binding Accent}" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" ToolTip="{Binding Detail}"/>
                  </Grid>
                </Border>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="LogEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock Text="≡" Foreground="#71859A" FontSize="28" HorizontalAlignment="Center"/>
              <TextBlock Text="No Logs Yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
              <TextBlock Text="Activity and playback messages will appear here." Foreground="{StaticResource SecondaryBrush}" Margin="0,6,0,0"/>
            </StackPanel>
          </Grid>
        </Grid>
        <!-- SETTINGS -->
        <Grid x:Name="SettingsPage" Visibility="Collapsed" Background="{DynamicResource PanelBrush}">
          <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="12" VerticalAlignment="Center">
              <Button x:Name="SettingsGeneralTab" Tag="General" Click="SwitchSettingsTab" Padding="13,7" Margin="0,0,6,0">⚙  General</Button>
              <Button x:Name="SettingsAppearanceTab" Tag="Appearance" Click="SwitchSettingsTab" Padding="13,7" Margin="0,0,6,0">◐  Appearance</Button>
              <Button x:Name="SettingsHotkeysTab" Tag="Hotkeys" Click="SwitchSettingsTab" Padding="13,7" Margin="0,0,6,0">⌨  Hotkeys</Button>
              <Button x:Name="SettingsPermissionsTab" Tag="Permissions" Click="SwitchSettingsTab" Padding="13,7">♧  Permissions</Button>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="SettingsGeneralContent" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="16">
              <TextBlock Text="General" FontSize="22" FontWeight="Bold"/>
              <TextBlock Text="Safety and target-window behavior" Foreground="{StaticResource SecondaryBrush}" Margin="0,4,0,16"/>
              <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
                <TextBlock Text="◈  Safety" Foreground="#38C98A" FontSize="16" FontWeight="SemiBold"/>
                <Grid Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Emergency stop" Foreground="{StaticResource SecondaryBrush}"/><TextBlock Grid.Column="1" Text="F7" FontWeight="SemiBold"/></Grid>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>
                <TextBlock Text="Stop, errors, target termination, and app termination release held automation keys and mouse buttons." Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
                <TextBlock Text="▣  Window targeting" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="SemiBold"/>
                <Grid Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Window discovery" Foreground="{StaticResource SecondaryBrush}"/><TextBlock Grid.Column="1" Text="Visible top-level windows" FontWeight="SemiBold"/></Grid>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>
                <TextBlock Text="Compatibility playback brings the target forward when an application ignores background messages." Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Data folder" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DataFolderText" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/><Button Click="OpenDataFolder" HorizontalAlignment="Left">Open Data Folder</Button></StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="SettingsAppearanceContent" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="16">
              <TextBlock Text="Appearance" FontSize="22" FontWeight="Bold"/>
              <TextBlock Text="Choose a color palette for Macro." Foreground="{StaticResource SecondaryBrush}" Margin="0,4,0,16"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Color palette" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ComboBox x:Name="AppearancePaletteBox" Width="220" HorizontalAlignment="Left" SelectionChanged="AppearancePaletteChanged">
                  <ComboBoxItem Content="Current" Tag="current"/>
                  <ComboBoxItem Content="Graphite" Tag="graphite"/>
                  <ComboBoxItem Content="High Contrast" Tag="highContrast"/>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Rectangle x:Name="AppearanceWindowSwatch" Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="#060C13" Stroke="{DynamicResource BorderBrush}"/>
                  <Rectangle x:Name="AppearancePanelSwatch" Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="#0A1420" Stroke="{DynamicResource BorderBrush}" Margin="5,0,0,0"/>
                  <Rectangle x:Name="AppearanceAccentSwatch" Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="#0E79FF" Stroke="{DynamicResource BorderBrush}" Margin="5,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="AppearancePaletteDescription" Text="The original deep blue palette" Foreground="{StaticResource SecondaryBrush}" Margin="0,10,0,0"/>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="SettingsHotkeysContent" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="16">
              <TextBlock Text="Global Hotkeys" FontSize="22" FontWeight="Bold"/>
              <TextBlock Text="These shortcuts work while Macro is in the background." Foreground="{StaticResource SecondaryBrush}" Margin="0,4,0,16"/>
              <Border Style="{StaticResource Card}" Padding="14"><StackPanel>
                <TextBlock Text="Choose a function key for each action. Changes apply immediately and work while Macro is in the background." Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="●" Foreground="#F03553" FontSize="17" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Record" FontWeight="SemiBold"/><TextBlock Text="Begins recording into a new macro" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/></StackPanel><ComboBox x:Name="RecordHotkeyBox" Grid.Column="2"/></Grid>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="■" Foreground="#F4A340" FontSize="17" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Stop" FontWeight="SemiBold"/><TextBlock Text="Ends recording or stops playback" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/></StackPanel><ComboBox x:Name="StopHotkeyBox" Grid.Column="2"/></Grid>
                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="▶" Foreground="#38C98A" FontSize="17" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Play" FontWeight="SemiBold"/><TextBlock Text="Runs the selected macro" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/></StackPanel><ComboBox x:Name="PlayHotkeyBox" Grid.Column="2"/></Grid>
                <StackPanel Orientation="Horizontal"><Button Click="ApplyHotkeys" Padding="14,7" Margin="0,0,8,0">Apply Hotkeys</Button><Button Click="RestoreHotkeys" Padding="14,7">Restore Defaults</Button></StackPanel>
                <TextBlock x:Name="HotkeyRegistrationStatus" Text="Hotkeys will be registered when Macro starts." Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="SettingsPermissionsContent" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="16">
              <TextBlock Text="Permissions" FontSize="22" FontWeight="Bold"/>
              <TextBlock Text="Windows input access and playback behavior" Foreground="{StaticResource SecondaryBrush}" Margin="0,4,0,16"/>
              <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="⌨  Input monitoring" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Required for recording and global stop" Foreground="{StaticResource SecondaryBrush}" Margin="0,10,0,0"/><TextBlock Text="Macro uses Windows input hooks to capture keyboard and mouse actions. Windows may restrict hooks across elevated processes." Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="◎  Playback access" FontSize="16" FontWeight="SemiBold" Foreground="#38C98A"/><TextBlock Text="Macro uses window messages for Background playback and SendInput for Compatibility playback. Elevated targets may require Macro to run at the same integrity level." Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
              <TextBlock Text="Windows owns these access decisions. Use Compatibility playback when a target does not accept background input." Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
    <Border x:Name="RecordingHud" Panel.ZIndex="50" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" Background="#F0101925" BorderBrush="#EF4053" BorderThickness="1" CornerRadius="14" Padding="14,10">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="9" Height="9" Fill="#EF3348" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="RecordingHudLabel" Text="Starting recording" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="RecordingHudTimer" Text="00:00" Foreground="#FF8391" FontFamily="Consolas" FontWeight="Bold" Margin="12,0,12,0" VerticalAlignment="Center"/>
        <Button Click="HudStopRecording" Padding="8,4" Background="#5A2431" BorderBrush="#824052">Stop</Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>
