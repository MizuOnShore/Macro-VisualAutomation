<?xml version="1.0"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Macro.Windows" x:Class="Macro.Windows.MainWindow" Title="Macro &#x2014; Automation Studio" Width="1240" Height="760" MinWidth="920" MinHeight="600" WindowStartupLocation="Manual" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="#060C13" Foreground="#F4F7FA" FontFamily="Segoe UI" FontSize="13">
  <Window.Icon>
    <DrawingImage>
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#E7334A" Geometry="M0,0 H32 V32 H0 Z"/>
          <GeometryDrawing Brush="Transparent" Geometry="M7,7 H18 V18 H7 Z">
            <GeometryDrawing.Pen><Pen Brush="White" Thickness="3"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="White" Geometry="M20,20 H27 V27 H20 Z"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
  </Window.Icon>
  <Window.Resources>
    <local:ProcessIconConverter x:Key="ProcessIconConverter"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#060C13"/>
    <SolidColorBrush x:Key="ToolbarBrush" Color="#09111B"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#081019"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#0A1420"/>
    <SolidColorBrush x:Key="CardBrush" Color="#0E1925"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="#121F2D"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#1F3348"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0E79FF"/>
    <SolidColorBrush x:Key="CanvasBrush" Color="#050B11"/>
    <SolidColorBrush x:Key="GridBrush" Color="#30526E"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#8DA3B8"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F4F7FA"/>
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#42607B"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Opacity" Value=".78"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value=".38"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#5A2431"/>
      <Setter Property="BorderBrush" Value="#824052"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="8,1"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
      <Setter Property="Foreground" Value="#F5F8FA"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="SelectionBrush" Value="#317FD1"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style x:Key="SearchField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="28,5,10,5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="SearchBorder" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9"><Grid><TextBlock Text="⌕" Foreground="#708AA1" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,1"/><ScrollViewer x:Name="PART_ContentHost" Margin="27,0,8,0" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SearchBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
      <Setter Property="Foreground" Value="#F5F8FA"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
              <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#9DB2C5" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/></Grid></ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="10,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                <Border Background="#102A40" BorderBrush="#2A5A7C" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="260" Margin="4" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#3B78A3"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value=".45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#F5F8FA"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="9,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1B4565"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#164D7D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#DDE7F0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" Background="#102C43" BorderBrush="#39627F" BorderThickness="1" CornerRadius="4"><Path x:Name="Check" Data="M 3 8 L 7 12 L 15 4" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/></Border><ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Box" Property="BorderBrush" Value="#4AA1FF"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#70B7FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="#31536C" CornerRadius="5" Margin="2,0"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#477594"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#F5F8FA"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="row" Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,9">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="row" Property="Background" Value="#112F48"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="row" Property="Background" Value="#123B62"/>
                <Setter TargetName="row" Property="BorderBrush" Value="#277FD1"/>
                <Setter TargetName="row" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="PlaybackSegment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#C8D2DB"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Segment" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="#1B3045"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#708AA1"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="190"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="72"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="84"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="14,13,8,10">
          <Border Width="38" Height="38" CornerRadius="11" Background="#E7334A">
            <Grid>
              <Ellipse Width="20" Height="20" Stroke="White" StrokeThickness="3"/>
              <Ellipse Width="6" Height="6" Fill="White"/>
            </Grid>
          </Border>
          <StackPanel Margin="10,1,0,0">
            <TextBlock Text="Macro" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="Automation studio" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0">
          <Button x:Name="NavMacros" Style="{StaticResource NavButton}" Tag="Macros" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x2318;" FontSize="15" Width="24"/>
              <TextBlock Text="Macros" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavRecorder" Style="{StaticResource NavButton}" Tag="Recorder" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x25CE;" FontSize="15" Width="24"/>
              <TextBlock Text="Recorder" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavTarget" Style="{StaticResource NavButton}" Tag="Target" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x25AD;" FontSize="16" Width="24"/>
              <TextBlock Text="Target" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavLogs" Style="{StaticResource NavButton}" Tag="Logs" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x2261;" FontSize="17" Width="24"/>
              <TextBlock Text="Logs" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavAutomation" Style="{StaticResource NavButton}" Tag="Automation" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x26AF;" FontSize="16" Width="24"/>
              <TextBlock Text="Automation" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="Settings" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x2699;" FontSize="15" Width="24"/>
              <TextBlock Text="Settings" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource CardBrush}">
                <TextBlock Text="&#x25CE;" Foreground="#6E8498" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="9,0,0,0">
                <TextBlock x:Name="SidebarTarget" Text="No target" FontWeight="SemiBold"/>
                <TextBlock x:Name="SidebarTargetSub" Text="Choose a window" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/>
              </StackPanel>
            </StackPanel>
            <Separator Margin="0,8,0,7" Background="#1F3348"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="ActivityDot" Width="7" Height="7" Fill="#6E8498" Margin="0,0,8,0"/>
              <TextBlock x:Name="SidebarActivity" Grid.Column="1" Text="Ready" FontSize="12"/>
              <TextBlock Grid.Column="2" Text="BETA" Foreground="#6E8498" FontSize="10"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragWindow">
        <Grid Margin="18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="HeaderIconContainer" Width="30" Height="30" CornerRadius="8" Background="#0D263C">
              <TextBlock x:Name="HeaderIcon" Text="&#x2318;" Foreground="{DynamicResource AccentBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="HeaderTitle" Text="Macros" FontSize="15" FontWeight="SemiBold" Margin="10,0,14,0" VerticalAlignment="Center"/>
            <Border x:Name="HeaderStatusBadge" Background="#152231" CornerRadius="14" Padding="10,5">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="HeaderDot" Width="7" Height="7" Fill="#6E8498" Margin="0,0,7,0"/>
                <TextBlock x:Name="HeaderStatus" Text="Ready" FontSize="12"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="HeaderRunControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PlayButton" Click="PlayClicked" Padding="13,6" Margin="0,0,8,0">&#x25B6;  Play</Button>
            <Button x:Name="PauseButton" Click="PauseClicked" Width="40" Margin="0,0,8,0">&#x2161;</Button>
            <Button x:Name="StopButton" Click="StopClicked" Width="40">&#x25A0;</Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <!-- MACROS -->
        <Grid x:Name="MacrosPage">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MacroLibraryColumn" Width="*"/>
            <ColumnDefinition x:Name="MacroInspectorColumn" Width="360"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel LastChildFill="False" Margin="18,14,18,10">
                <TextBlock Text="Recordings" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                  <Border Background="{DynamicResource RaisedBrush}" CornerRadius="12" Padding="8,4" Margin="0,0,8,0"><TextBlock x:Name="MacroCount" Text="0" FontSize="11"/></Border>
                  <Button Tag="Recorder" Click="Navigate" Background="#EF3348" BorderBrush="#EF3348" Padding="10,6">●  Record</Button>
                </StackPanel>
              </DockPanel>
              <Grid Grid.Row="1" Margin="18,0,18,12">
                <TextBox x:Name="MacroSearch" Style="{StaticResource SearchField}" TextChanged="MacroSearchChanged" ToolTip="Search recordings"/>
                <TextBlock Text="Search recordings" Foreground="#788A9D" FontSize="12" VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=MacroSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
              <Grid Grid.Row="2">
                <ListBox x:Name="MacroList" SelectionChanged="MacroSelected" PreviewMouseRightButtonDown="MacroListRightClick" Margin="14,0">
                  <ListBox.ContextMenu>
                    <ContextMenu Background="{DynamicResource RaisedBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}">
                      <MenuItem Header="Play Recording" Click="PlayClicked"/>
                      <MenuItem Header="Duplicate" Click="DuplicateMacro"/>
                      <MenuItem Header="Rename" Click="RenameSelectedMacro"/>
                      <Separator/>
                      <MenuItem Header="Delete Recording" Click="DeleteMacro"/>
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="RecordingRow" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="11,10" Margin="0,0,0,6">
                        <Grid>
                          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="28"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="›" Foreground="#6F94B2" FontSize="16"/>
                            <TextBlock x:Name="RecordingIcon" DockPanel.Dock="Left" Text="≋" Foreground="#75899D" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          </DockPanel>
                          <local:RecordingWaveform x:Name="RecordingWaveform" Grid.Row="1" ActionCount="{Binding Actions.Count}" Height="28" Margin="0,8,0,3"/>
                          <StackPanel Grid.Row="2" Orientation="Horizontal"><TextBlock Text="{Binding Actions.Count, StringFormat={}{0} actions}" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/><TextBlock Text="  ·  " Foreground="#617A91" FontSize="11"/><TextBlock Text="{Binding LoopMode}" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/><TextBlock Text="  ·  " Foreground="#617A91" FontSize="11"/><TextBlock Text="{Binding MousePlaybackMode}" Foreground="#6F94B2" FontSize="11"/></StackPanel>
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                          <Setter TargetName="RecordingRow" Property="Background" Value="#0D1927"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                          <Setter TargetName="RecordingRow" Property="Background" Value="#102D4B"/>
                          <Setter TargetName="RecordingRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                          <Setter TargetName="RecordingWaveform" Property="Tint" Value="{DynamicResource AccentBrush}"/>
                          <Setter TargetName="RecordingIcon" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="MacroEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock Text="No recordings found" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="Create a macro or change your search." Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <ListBox x:Name="ActionList" Visibility="Collapsed" SelectionChanged="ActionSelected" Margin="14,0">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ActionRow" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionRow" Property="BorderBrush" Value="#2C5B7D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ActionRow" Property="BorderBrush" Value="#218BEE"/><Setter TargetName="ActionRow" Property="Background" Value="#0D2A43"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                  </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate><Border Background="#0E273B" BorderBrush="#1E4563" BorderThickness="1" CornerRadius="11" Padding="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="10" Background="#153B5A"><TextBlock Text="◆" Foreground="#4C9CFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Type}" FontWeight="SemiBold"/><TextBlock Text="{Binding}" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" Click="ActionEnabledChanged" VerticalAlignment="Center" ToolTip="Enable or disable this action"/></Grid></Border></DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
              <StackPanel Grid.Row="3" Background="{DynamicResource ToolbarBrush}">
                <Grid x:Name="LibraryFooter" Margin="14,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
